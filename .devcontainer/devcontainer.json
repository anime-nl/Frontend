{
  "name": "Nuxt.js (TypeScript)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "NuxtJS",
      "onAutoForward": "notify"
    },
  },
  "postCreateCommand": "npm install -g nuxi && npm install",
  "remoteUser": "node"
}
