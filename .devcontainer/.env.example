# Not committed (see .gitignore). Copy to .devcontainer/.env and fill in a Google OAuth 2.0
# Web application client (Google Cloud Console > APIs & Services > Credentials) with redirect URIs
# http://localhost:3000/account/callback/google and https://<production-domain>/account/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mollie test/sandbox API key (Mollie dashboard > Developers > API keys), starts with "test_".
MOLLIE_API_KEY=
