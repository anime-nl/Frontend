{
  "name": "animenl-website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --project nuxt --coverage",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "nodemailer": "^10.5.0",
    "nuxt": "^4.6.4",
    "nuxt-gtag": "^5.0.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/at-icons": "^1.2.5",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.153",
    "@iconify-json/material-symbols": "^1.2.98",
    "@iconify-json/material-symbols-light": "^1.2.100",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/pinhead": "^1.2.41",
    "@iconify-json/simple-icons": "^1.2.102",
    "@medusajs/types": "2.22.6",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/devtools-core": "^8.2.1",
    "@vue/devtools-kit": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
