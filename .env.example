MEDUSA_URL=http://medusa.localhost:9000/
MEDUSA_PUBLISHABLE_KEY=pk_local_dev_0000000000000000000000000000000000000000000000000000
MEDUSA_SALES_CHANNEL_ID=
# Shipping profile ids that pick which shipping options checkout shows (Brievenbus for mailbox-fit items, Pakket otherwise).
# The dev container's seed script logs these after seeding; production values come from the Medusa admin.
MEDUSA_BRIEVENBUS_SHIPPING_PROFILE_ID=
MEDUSA_PAKKET_SHIPPING_PROFILE_ID=
# Optional: URL the Nuxt server uses to reach Medusa (defaults to MEDUSA_URL)
# MEDUSA_SERVER_URL=http://localhost:9000/
# SMTP server for the /support forms (production uses Brevo). Without SMTP_HOST, development only logs the emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Public URL of the deployed site, used to build the sitemap and absolute URLs (defaults to https://animenl.nl)
# SITE_URL=
# Google Analytics measurement id (e.g. G-XXXXXXXXXX). Only takes effect in a production build (NODE_ENV=production);
# without it, Google Analytics is never loaded. Visitors still see a cookie consent banner before it starts tracking.
# GA_MEASUREMENT_ID=
